<Window x:Class="Shizi.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True"
        Cursor="Cross" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
  <Grid x:Name="Root">
    <Image x:Name="ScreenshotImage" Stretch="Fill" />
    <Canvas x:Name="ShadeCanvas" IsHitTestVisible="False">
      <Rectangle x:Name="ShadeTop" Fill="#8A060807" />
      <Rectangle x:Name="ShadeLeft" Fill="#8A060807" />
      <Rectangle x:Name="ShadeRight" Fill="#8A060807" />
      <Rectangle x:Name="ShadeBottom" Fill="#8A060807" />
      <Border x:Name="SelectionBorder" BorderBrush="#B8F35B" BorderThickness="2"
              CornerRadius="3" Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect Color="#B8F35B" BlurRadius="10" Opacity="0.32" ShadowDepth="0" />
        </Border.Effect>
      </Border>
    </Canvas>
    <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,34,0,0" Padding="15,9" CornerRadius="12"
            Background="#E8171A18" BorderBrush="#3B413C" BorderThickness="1"
            IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Fill="#B8F35B" Margin="0,0,9,0" />
        <TextBlock Text="拖动框选文字  ·  Esc 取消" Foreground="#F4F1EA"
                   FontFamily="Segoe UI Variable, Microsoft YaHei UI" FontSize="13" />
      </StackPanel>
    </Border>
  </Grid>
</Window>

